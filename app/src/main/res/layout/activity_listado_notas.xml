<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F4F6FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mis notas"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1B2845"
        android:layout_marginBottom="18dp" />

    <ProgressBar
        android:id="@+id/progresoListado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtSinNotas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Todavía no tienes notas guardadas"
        android:textSize="16sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp" />

    <Button
        android:id="@+id/btnReintentar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reintentar"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerNotas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnVolverListado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:backgroundTint="#64748B" />

</LinearLayout>
